 586  eq_fob_quad_dif_k
 587  * Budget
 588  eq_budget
 589  eq_no_budget
 590  eq_mass(inode)
 591  eq_mass_espec(inode_espec)
 592   
 593  ;
 594   
 595  * Auxiliares
 596  *eq_lvalve_open(ipipe).. 0 =e= lvalve(icirc);
 597  eq_dummy..              dummy =e= 0;
 598   
 599  * Unidade de escolhas
 600  eq_ypi_unity(ipipe)..   1 =e= sum(n,y_pi(ipipe,n));
 601  eq_ypu_unity(ipump)..   1 =e= sum(s,y_pu(ipump,s));
 602   
 603  * Vazoes
 604  eq_k_edge(iedge)..      k_edge(iedge) =e= rho*q_edge(iedge);
 605  eq_q_edge(iedge)..      q_edge(iedge) =e= sum(icirc,LAMBDA(icirc,iedge)*q_
      circ(icirc));
 606   
 607  * Mass Balance
 608  eq_mass(inode)..        sum(iedge,K(inode,iedge)*k_edge(iedge)) + w_node(i
      node) =e= 0;
 609  eq_mass_espec(inode_espec).. w_node(inode_espec) =e= 0;
 610   
 611  * Heads
 612  eq_f_he(ihe)..          f_he(ihe)       =e= f_he_w_d(ihe)*(k_edge(ihe)/k_h
      e_w_d(ihe))**alfa;
 613  eq_f_pi(ipipe,n)..      f_pi(ipipe,n)   =e= (10.67/(c_hw**1.85))*(q_edge(i
      pipe)**1.852)/(din(n)**4.8704)*l(ipipe);
 614  eq_f_pu(ipump,s)..      f_pu(ipump,s)       =e= sum(i,a(i,s)*(q_edge(ipump
      ))**i.val) ;
 615   
 616  * Hidraulica
 617  eq_circ(icirc)..        0.0 =e= sum(ipump,sum(s,y_pu(ipump,s)*LAMBDA(icirc
      ,ipump)*f_pu(ipump,s))) - dz - sum((ipipe,n),LAMBDA(icirc,ipipe)*f_pi(ipip
      e,n)*y_pi(ipipe,n)) - sum(ihe,LAMBDA(icirc,ihe)*f_he(ihe)) - lvalve(icirc)
      ;
 618   
 619  * Velecidade Máxima
 620  eq_vteste(ipipe)..      vteste(ipipe) - sum(n,4*zq_k_n(ipipe,n)/pi/(din(n)
      **2)) =e= 0;
 621  eq_vmax(ipipe)..        vmax =g= vteste(ipipe);
 622  eq_vmin(ipipe)..        vmin =l= vteste(ipipe);
 623  eq_vmax_lim1(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge(ipipe) - q_edge_max(ipi
      pe)*(1-y_pi(ipipe,n));
 624  eq_vmax_lim2(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge(ipipe) - q_edge_min(ipi
      pe)*(1-y_pi(ipipe,n)) ;
 625  eq_vmax_lim3(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge_min(ipipe)*y_pi(ipipe,n
      );
 626  eq_vmax_lim4(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge_max(ipipe)*y_pi(ipipe,n
      ) ;
 627   
 628   
 629   
 630  * Especificacoes
 631  eq_k_hot(ihe)..         k_he_hot(ihe) =e= fator_k_he_hot_spe(ihe)*k_he_hot
      _d(ihe);
 632  eq_k_he_w(ihe)..        k_edge(ihe) =e= k_he_w_d(ihe);
 633  eq_T_w_in_spe(ihe)..    T_w_in(ihe) =e= T_w_in_spe;
 634  eq_T_hot_out_spe(ihe).. T_hot_out(ihe) =e= T_hot_out_spe(ihe);
 635   
 636  * Trocadores
 637  eq_cr(ihe)..         cr(ihe)*(k_edge(ihe)*cp_w) =e= (k_he_hot(ihe)*cp_hot(
      ihe));
 638  eq_h_w(ihe)..        h_w(ihe)   =e= h_w_d(ihe)*(k_edge(ihe)/k_he_w_d(ihe))
      **0.8;
 639  eq_h_hot(ihe)..      h_hot(ihe) =e= h_hot_d(ihe)*(k_he_hot(ihe)/k_he_hot_d
      (ihe))**0.6;
 640  eq_U(ihe)..          U(ihe)*(h_hot(ihe)*(D_he_ext(ihe)/D_he_int(ihe)) + (h
      _w(ihe)*h_hot(ihe)/(2*k_wall))*D_he_ext(ihe)*log(D_he_ext(ihe)/D_he_int(ih
      e)) + h_w(ihe) + h_w(ihe)*h_hot(ihe)*Rf_tot(ihe) ) =e=  h_w(ihe)*h_hot(ihe
      ) ;
 641  eq_NTU(ihe)..        NTU(ihe)*(k_he_hot(ihe)*cp_hot(ihe)) =e= U(ihe)*A_he(
      ihe);
 642  eq_epsilon(ihe)..    epsilon(ihe)*((1 + CR(ihe))*(1 - exp(-NTU(ihe)*( sqrt
      (1+sqr(CR(ihe))) ))) + sqrt(1+sqr(CR(ihe))) * ( (1 + exp(-NTU(ihe)*( sqrt(
      1+sqr(CR(ihe))) ))) )) =e= 2*(1 - exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) )))
      ;
 643  eq_T_hot_out(ihe)..  T_hot_in(ihe)-T_hot_out(ihe) =e= epsilon(ihe)*(T_hot_
      in(ihe)-T_w_in(ihe));
 644  eq_T_w_out(ihe)..    T_w_out(ihe) =e= T_w_in(ihe) + cr(ihe)*epsilon(ihe)*(
      T_hot_in(ihe)-T_w_in(ihe));
 645   
 646  * Torre Simplificada
 647  eq_T_w_in(ihe)..    (T_w_in(ihe)-T_w_wb)*epsilon_tower =e= (T_w_feed-T_w_i
      n(ihe)) ;
 648   
 649  * Torre Detalhada
 650  eq_Hsat_m(m_Merkel)..    Hsat_m(m_Merkel) =e= (a_Hsat + b_Hsat*T_w_m(m_Mer
      kel) + c_Hsat * exp(d_Hsat*T_w_m(m_Merkel)))*1e3;
 651  eq_T_w_m(m_Merkel)..     T_w_m(m_Merkel)   =e= T_w_base + (T_w_feed -T_w_b
      ase)*alfa_torre(m_Merkel);
 652  eq_H_m(m_Merkel)..       H_m(m_Merkel)    =e= Hatm + cp_w*rho*sum(ihe,q_ed
      ge(ihe))*(T_w_m(m_Merkel)-T_w_base)/m_air;
 653  eq_IM..                  IM =e= (cp_w*(T_w_feed - T_w_base)/4)*sum(m_Merke
      l,1/(Hsat_m(m_Merkel)-H_m(m_Merkel)+1));
 654  eq_Ip..                  Ip*(rho*sum(ihe,q_edge(ihe))/m_air)**n_torre =e= 
      delta_pack*C_un;
 655  eq_Merkel..              IM =e= Ip;
 656  eq_torre_lim..           T_w_base =l= T_w_feed;
 657  eq_T_w_in_torre(ihe)..   T_w_in(ihe) =e= T_w_base ;
 658  eq_T_w_base_lim..        T_w_base =g= T_w_wb;
 659   
 660  * Torre
 661  eq_T_w_feed_limit.. T_w_feed =l= T_w_feed_max;
 662  eq_T_w_feed..       T_w_feed*sum(ihe,k_edge(ihe)) =e= sum(ihe,k_edge(ihe)*
      T_w_out(ihe));
 663   
 664  * Penalidade
 665  eq_che(ihe)..            che(ihe) =e= pen(ihe)*(z_hot_out(ihe) - T_hot_out
      _spe(ihe)*y_he(ihe));
 666  eq_penalty_lim1(ihe)..   z_hot_out(ihe) =g= T_hot_out(ihe) - T_hot_out_max
      (ihe)*(1-y_he(ihe)) ;
 667  eq_penalty_lim2(ihe)..   z_hot_out(ihe) =l= T_hot_out(ihe) - T_hot_out_min
      (ihe)*(1-y_he(ihe)) ;
 668  eq_penalty_lim3(ihe)..   z_hot_out(ihe) =g= T_hot_out_min(ihe)*y_he(ihe) ;
 669  eq_penalty_lim4(ihe)..   z_hot_out(ihe) =l= T_hot_out_max(ihe)*y_he(ihe) ;
 670  eq_penalty_lim5(ihe)..   (T_hot_out(ihe)-T_hot_out_spe(ihe)) =g= (1-y_he(i
      he))*(T_hot_out_min(ihe)-T_hot_out_spe(ihe));
 671  eq_penalty_lim6(ihe)..   (T_hot_out(ihe)-T_hot_out_spe(ihe)) =l= (y_he(ihe
      ))*(T_hot_out_max(ihe)-T_hot_out_spe(ihe));
 672   
 673  * Custos
 674  eq_cope..               cope   =e= sum(ipump,sum(s,y_pu(ipump,s)*f_pu(ipum
      p,s))*k_edge(ipump)*g/eta*(nop*pc/1000)) ;
 675  eq_cpipe..              cpipe =e= sum((ipipe,n),cpi(n)*y_pi(ipipe,n)*(1-yp
      i_existent(ipipe,n))*l(ipipe));
 676  eq_cpump..              cpump =e= sum((ipump,s),cpu(s)*y_pu(ipump,s)*(1-yp
      u_existent(ipump,s)));
 677  eq_cpen..               cpen  =e= sum(ihe,che(ihe));
 678   
 679  * FOB
 680  eq_fob..                fob =e= cpipe + cpump + cope;
 681  eq_fob_w_penalty..      fob =e= cpipe + cpump + cope + cpen;
 682  eq_forced..             cpen =l= cpen_limit;
 683  eq_fob_quad_dif_k..       fob =e= sum(ihe,(k_edge(ihe)-k_edge_spe(ihe))*(k
      _edge(ihe)-k_edge_spe(ihe)));
 684   
 685  * Budget
 686  eq_budget..   cpipe + cpump =l= Budget ;
 687  eq_no_budget.. cpipe + cpump =e= 0;
 688   
 689  * FIM ********************************************************************
      *****
 690   
 691  * Definindo o modelo
 692  model design_original_simplificado
 693  /
 694  * Unidade de escolhas
 695  eq_ypi_unity
 696  eq_ypu_unity
 697  * Vazoes
 698  eq_k_edge
 699  eq_q_edge
 700  *eq_mass
 701  *eq_mass_espec
 702  * Heads
 703  eq_f_he
 704  eq_f_pi
 705  eq_f_pu
 706  * Hidraulica
 707  eq_circ
 708  * Velecidade Máxima
 709  eq_vmax
 710  *eq_vmin
 711  eq_vteste
 712  eq_vmax_lim1
 713  eq_vmax_lim2
 714  eq_vmax_lim3
 715  eq_vmax_lim4
 716  * Especificacoes
 717  eq_k_he_w
 718  * Custos
 719  eq_cope
 720  eq_cpipe
 721  eq_cpump
 722  eq_cpen
 723  * FOB
 724  eq_fob
 725  /;
 726   
 727  * Ajustando os parametros do método numério (SBB)
 728  design_original_simplificado.Nodlim=500000;
 729  design_original_simplificado.optca=1e-3;
 730  design_original_simplificado.optcr=1e-3;
 731   
 732  * Resolvendo para min(FOB)
 733  solve design_original_simplificado minimizing fob using minlp;
 734  Display 'design_original_simplificado',
 735  fob.l,
 736  cope.l,
 737  cpipe.l,
 738  cpump.l,
 739  q_edge.l,
 740  k_edge.l,
 741  vteste.l,
 742  f_pi.l,
 743  f_pu.l,
 744  f_he.l,
 745  y_pi.l,
 746  y_pu.l;
 747   
 748  * Guarando o resultado no arquivo GDX
 749  execute_unload 'gdx/design_original_simplificado.gdx';
