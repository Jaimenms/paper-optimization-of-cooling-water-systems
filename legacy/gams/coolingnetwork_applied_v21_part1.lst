 417   
 418  * Finding circ matrix (LAMBDA) from Incidence Matrix (K)
 419  Parameter LAMBDA(icirc,iedge) hydraulic circ matrix;
 420  Parameter iedge_found teste;
 421  Set jedge(iedge) edge index   / set.iedge /
 422  loop((icirc,ihe),
 423           if (ord(icirc) eq ord(ihe),
 424                   LAMBDA(icirc,ihe)=1;
 425                   iedge_found = ihe.val;
 426                   while (iedge_found NE 0,
 427                            loop(jedge,
 428                                   if (jedge.val EQ iedge_found,
 429                                     iedge_found = 0;
 430                                     loop(inode,
 431                                             if (K(inode,jedge) EQ +1,
 432                                                     loop(iedge,
 433                                                             if (K(inode,ied
      ge) EQ -1,
 434                                                                     LAMBDA(
      icirc,iedge)=1;
 435                                                                     iedge_f
      ound = iedge.val;
 436                                                             );
 437                                                     );
 438                                             );
 439                                    );
 440                                   );
 441                           );
 442                   );
 443                   iedge_found = ihe.val;
 444                   while (iedge_found NE 0,
 445                            loop(jedge,
 446                                   if (jedge.val EQ iedge_found,
 447                                     iedge_found = 0;
 448                                     loop(inode,
 449                                             if (K(inode,jedge) EQ -1,
 450                                                     loop(iedge,
 451                                                             if (K(inode,ied
      ge) EQ +1,
 452                                                                     LAMBDA(
      icirc,iedge)=1;
 453                                                                     iedge_f
      ound = iedge.val;
 454                                                             );
 455                                                     );
 456                                             );
 457                                    );
 458                                   );
 459                           );
 460                   );
 461           );
 462  );
