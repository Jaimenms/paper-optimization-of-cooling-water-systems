 382  * Costs ========================================================================
 383   
 384  Parameter cpi(n) pipe section nominal eq_fob ;
 385            cpi(n) = ((c1/0.3048)*(dnom(n)/12)**m) ;
 386   
 387  Parameter fpud(s) pump head design ;
 388            fpud(s)= sum(i,a(i,s)*(qpud(s))**i.val) ;
 389   
 390  Parameter ft(s) pump capital eq_fob factor ft;
 391        ft(s) = exp(sum(j,b(j)*(log(28710*qpud(s)*fpud(s)**0.5))**j.val)) ;
 392   
 393  Parameter zpu(s) pump capital eq_fob factor zpu;
 394        zpu(s) = 28710*qpud(s)*fpud(s)**0.5 ;
 395   
 396  Parameter cpu(s) pump eq_fob ;
 397        cpu(s) = rfactor*fi*fms*fm*ft(s)*(1.39*exp(8.833-0.6019*log(zpu(s))+0.0519*(log(zpu(s)))**2))  ;
 398   
