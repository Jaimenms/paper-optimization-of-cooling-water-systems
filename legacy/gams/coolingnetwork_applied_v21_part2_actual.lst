 613   
 614  * Heads
 615  eq_f_he(ihe)..          f_he(ihe)       =e= f_he_w_d(ihe)*(k_edge(ihe)/k_he_w_d(ihe))**alfa;
 616  eq_f_pi(ipipe,n)..      f_pi(ipipe,n)   =e= (10.67/(c_hw**1.85))*(q_edge(ipipe)**1.852)/(din(n)**4.8704)*l(ipipe);
 617  eq_f_pu(ipump,s)..      f_pu(ipump,s)       =e= sum(i,a(i,s)*(q_edge(ipump))**i.val) ;
 618   
 619  * Hidraulica
 620  eq_circ(icirc)..        0.0 =e= sum(ipump,sum(s,y_pu(ipump,s)*LAMBDA(icirc,ipump)*f_pu(ipump,s))) - dz - sum((ipipe,n),LAMBDA(icirc,ipipe)*f_pi(ipipe,n)*y_pi(ipipe,n)) - sum(ihe,LAMBDA(icirc,ihe)*f_he(ihe)) - lvalve(icirc);
 621   
 622  * Velecidade Máxima
 623  eq_vteste(ipipe)..      vteste(ipipe) - sum(n,4*zq_k_n(ipipe,n)/pi/(din(n)**2)) =e= 0;
 624  eq_vmax(ipipe)..        vmax =g= vteste(ipipe);
 625  eq_vmin(ipipe)..        vmin =l= vteste(ipipe);
 626  eq_vmax_lim1(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge(ipipe) - q_edge_max(ipipe)*(1-y_pi(ipipe,n));
 627  eq_vmax_lim2(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge(ipipe) - q_edge_min(ipipe)*(1-y_pi(ipipe,n)) ;
 628  eq_vmax_lim3(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge_min(ipipe)*y_pi(ipipe,n);
 629  eq_vmax_lim4(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge_max(ipipe)*y_pi(ipipe,n) ;
