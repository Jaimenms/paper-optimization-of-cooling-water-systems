 677  eq_cope..               cope   =e= sum(ipump,sum(s,y_pu(ipump,s)*f_pu(ipump,s))*k_edge(ipump)*g/eta*(nop*pc/1000)) ;
 678  eq_cpipe..              cpipe =e= sum((ipipe,n),cpi(n)*y_pi(ipipe,n)*(1-ypi_existent(ipipe,n))*l(ipipe));
 679  eq_cpump..              cpump =e= sum((ipump,s),cpu(s)*y_pu(ipump,s)*(1-ypu_existent(ipump,s)));
 680  eq_cpen..               cpen  =e= sum(ihe,che(ihe));
 681   
