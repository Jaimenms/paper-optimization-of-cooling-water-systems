 685  eq_forced..             cpen =l= cpen_limit;
 686  eq_fob_quad_dif_k..       fob =e= 1000*sum(ihe,(k_edge(ihe)-k_edge_spe(ihe))*(k_edge(ihe)-k_edge_spe(ihe)));
 687   
