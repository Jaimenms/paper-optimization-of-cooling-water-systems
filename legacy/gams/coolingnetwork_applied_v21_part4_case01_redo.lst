 383  * Costs ==================================================================
      ======
 384   
 385  Parameter cpi(n) pipe section nominal eq_fob ;
 386            cpi(n) = ((c1/0.3048)*(dnom(n)/12)**m) ;
 387   
 388  Parameter fpud(s) pump head design ;
 389            fpud(s)= sum(i,a(i,s)*(qpud(s))**i.val) ;
 390   
 391  Parameter ft(s) pump capital eq_fob factor ft;
 392        ft(s) = exp(sum(j,b(j)*(log(28710*qpud(s)*fpud(s)**0.5))**j.val)) ;
 393   
 394  Parameter zpu(s) pump capital eq_fob factor zpu;
 395        zpu(s) = 28710*qpud(s)*fpud(s)**0.5 ;
 396   
 397  Parameter cpu(s) pump eq_fob ;
 398        cpu(s) = rfactor*fi*fms*fm*ft(s)*(1.39*exp(8.833-0.6019*log(zpu(s))+
      0.0519*(log(zpu(s)))**2))  ;
 399   
