 421   
 422  * Finding circ matrix (LAMBDA) from Incidence Matrix (K)
 423  Parameter LAMBDA(icirc,iedge) hydraulic circ matrix;
 424  Parameter iedge_found teste;
 425  Set jedge(iedge) edge index   / set.iedge /
 426  loop((icirc,ihe),
 427           if (ord(icirc) eq ord(ihe),
 428                   LAMBDA(icirc,ihe)=1;
 429                   iedge_found = ihe.val;
 430                   while (iedge_found NE 0,
 431                            loop(jedge,
 432                                   if (jedge.val EQ iedge_found,
 433                                     iedge_found = 0;
 434                                     loop(inode,
 435                                             if (K(inode,jedge) EQ +1,
 436                                                     loop(iedge,
 437                                                             if (K(inode,ied
      ge) EQ -1,
 438                                                                     LAMBDA(
      icirc,iedge)=1;
 439                                                                     iedge_f
      ound = iedge.val;
 440                                                             );
 441                                                     );
 442                                             );
 443                                    );
 444                                   );
 445                           );
 446                   );
 447                   iedge_found = ihe.val;
 448                   while (iedge_found NE 0,
 449                            loop(jedge,
 450                                   if (jedge.val EQ iedge_found,
 451                                     iedge_found = 0;
 452                                     loop(inode,
 453                                             if (K(inode,jedge) EQ -1,
 454                                                     loop(iedge,
 455                                                             if (K(inode,ied
      ge) EQ +1,
 456                                                                     LAMBDA(
      icirc,iedge)=1;
 457                                                                     iedge_f
      ound = iedge.val;
 458                                                             );
 459                                                     );
 460                                             );
 461                                    );
 462                                   );
 463                           );
 464                   );
 465           );
 466  );
