 595  eq_mass_espec(inode_espec)
 596   
 597  ;
 598   
 599  * Auxiliares
 600  *eq_lvalve_open(ipipe).. 0 =e= lvalve(icirc);
 601  eq_dummy..              dummy =e= 0;
 602   
 603  * Unidade de escolhas
 604  eq_ypi_unity(ipipe)..   1 =e= sum(n,y_pi(ipipe,n));
 605  eq_ypu_unity(ipump)..   1 =e= sum(s,y_pu(ipump,s));
 606   
 607  * Vazoes
 608  eq_k_edge(iedge)..      k_edge(iedge) =e= rho*q_edge(iedge);
 609  eq_q_edge(iedge)..      q_edge(iedge) =e= sum(icirc,LAMBDA(icirc,iedge)*q_
      circ(icirc));
 610   
 611  * Mass Balance
 612  eq_mass(inode)..        sum(iedge,K(inode,iedge)*k_edge(iedge)) + w_node(i
      node) =e= 0;
 613  eq_mass_espec(inode_espec).. w_node(inode_espec) =e= 0;
 614   
 615  * Heads
 616  eq_f_he(ihe)..          f_he(ihe)       =e= f_he_w_d(ihe)*(k_edge(ihe)/k_h
      e_w_d(ihe))**alfa;
 617  eq_f_pi(ipipe,n)..      f_pi(ipipe,n)   =e= (10.67/(c_hw**1.85))*(q_edge(i
      pipe)**1.852)/(din(n)**4.8704)*l(ipipe);
 618  eq_f_pu(ipump,s)..      f_pu(ipump,s)       =e= sum(i,a(i,s)*(q_edge(ipump
      ))**i.val) ;
 619   
 620  * Hidraulica
 621  eq_circ(icirc)..        0.0 =e= sum(ipump,sum(s,y_pu(ipump,s)*LAMBDA(icirc
      ,ipump)*f_pu(ipump,s))) - dz - sum((ipipe,n),LAMBDA(icirc,ipipe)*f_pi(ipip
      e,n)*y_pi(ipipe,n)) - sum(ihe,LAMBDA(icirc,ihe)*f_he(ihe)) - lvalve(icirc)
      ;
 622   
 623  * Velecidade Máxima
 624  eq_vteste(ipipe)..      vteste(ipipe) - sum(n,4*zq_k_n(ipipe,n)/pi/(din(n)
      **2)) =e= 0;
 625  eq_vmax(ipipe)..        vmax =g= vteste(ipipe);
 626  eq_vmin(ipipe)..        vmin =l= vteste(ipipe);
 627  eq_vmax_lim1(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge(ipipe) - q_edge_max(ipi
      pe)*(1-y_pi(ipipe,n));
 628  eq_vmax_lim2(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge(ipipe) - q_edge_min(ipi
      pe)*(1-y_pi(ipipe,n)) ;
 629  eq_vmax_lim3(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge_min(ipipe)*y_pi(ipipe,n
      );
 630  eq_vmax_lim4(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge_max(ipipe)*y_pi(ipipe,n
      ) ;
 631   
 632   
 633   
 634  * Especificacoes
 635  eq_k_hot(ihe)..         k_he_hot(ihe) =e= fator_k_he_hot_spe(ihe)*k_he_hot
      _d(ihe);
 636  eq_k_he_w(ihe)..        k_edge(ihe) =e= k_he_w_d(ihe);
 637  eq_T_w_in_spe(ihe)..    T_w_in(ihe) =e= T_w_in_spe;
 638  eq_T_hot_out_spe(ihe).. T_hot_out(ihe) =e= T_hot_out_spe(ihe);
 639   
 640  * Trocadores
 641  eq_cr(ihe)..         cr(ihe)*(k_edge(ihe)*cp_w) =e= (k_he_hot(ihe)*cp_hot(
      ihe));
 642  eq_h_w(ihe)..        h_w(ihe)   =e= h_w_d(ihe)*(k_edge(ihe)/k_he_w_d(ihe))
      **0.8;
 643  eq_h_hot(ihe)..      h_hot(ihe) =e= h_hot_d(ihe)*(k_he_hot(ihe)/k_he_hot_d
      (ihe))**0.6;
 644  eq_U(ihe)..          U(ihe)*(h_hot(ihe)*(D_he_ext(ihe)/D_he_int(ihe)) + (h
      _w(ihe)*h_hot(ihe)/(2*k_wall))*D_he_ext(ihe)*log(D_he_ext(ihe)/D_he_int(ih
      e)) + h_w(ihe) + h_w(ihe)*h_hot(ihe)*Rf_tot(ihe) ) =e=  h_w(ihe)*h_hot(ihe
      ) ;
 645  eq_NTU(ihe)..        NTU(ihe)*(k_he_hot(ihe)*cp_hot(ihe)) =e= U(ihe)*A_he(
      ihe);
 646  eq_epsilon(ihe)..    epsilon(ihe)*((1 + CR(ihe))*(1 - exp(-NTU(ihe)*( sqrt
      (1+sqr(CR(ihe))) ))) + sqrt(1+sqr(CR(ihe))) * ( (1 + exp(-NTU(ihe)*( sqrt(
      1+sqr(CR(ihe))) ))) )) =e= 2*(1 - exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) )))
      ;
 647  eq_T_hot_out(ihe)..  T_hot_in(ihe)-T_hot_out(ihe) =e= epsilon(ihe)*(T_hot_
      in(ihe)-T_w_in(ihe));
 648  eq_T_w_out(ihe)..    T_w_out(ihe) =e= T_w_in(ihe) + cr(ihe)*epsilon(ihe)*(
      T_hot_in(ihe)-T_w_in(ihe));
 649   
 650  * Torre Simplificada
 651  eq_T_w_in(ihe)..    (T_w_in(ihe)-T_w_wb)*epsilon_tower =e= (T_w_feed-T_w_i
      n(ihe)) ;
 652   
 653  * Torre Detalhada
 654  eq_Hsat_m(m_Merkel)..    Hsat_m(m_Merkel) =e= (a_Hsat + b_Hsat*T_w_m(m_Mer
      kel) + c_Hsat * exp(d_Hsat*T_w_m(m_Merkel)))*1e3;
 655  eq_T_w_m(m_Merkel)..     T_w_m(m_Merkel)   =e= T_w_base + (T_w_feed -T_w_b
      ase)*alfa_torre(m_Merkel);
 656  eq_H_m(m_Merkel)..       H_m(m_Merkel)    =e= Hatm + cp_w*rho*sum(ihe,q_ed
      ge(ihe))*(T_w_m(m_Merkel)-T_w_base)/m_air;
 657  eq_IM..                  IM =e= (cp_w*(T_w_feed - T_w_base)/4)*sum(m_Merke
      l,1/(Hsat_m(m_Merkel)-H_m(m_Merkel)+1));
 658  eq_Ip..                  Ip*(rho*sum(ihe,q_edge(ihe))/m_air)**n_torre =e= 
      delta_pack*C_un;
 659  eq_Merkel..              IM =e= Ip;
 660  eq_torre_lim..           T_w_base =l= T_w_feed;
 661  eq_T_w_in_torre(ihe)..   T_w_in(ihe) =e= T_w_base ;
 662  eq_T_w_base_lim..        T_w_base =g= T_w_wb;
 663   
 664  * Torre
 665  eq_T_w_feed_limit.. T_w_feed =l= T_w_feed_max;
 666  eq_T_w_feed..       T_w_feed*sum(ihe,k_edge(ihe)) =e= sum(ihe,k_edge(ihe)*
      T_w_out(ihe));
 667   
 668  * Penalidade
 669  eq_che(ihe)..            che(ihe) =e= pen(ihe)*(z_hot_out(ihe) - T_hot_out
      _spe(ihe)*y_he(ihe));
 670  eq_penalty_lim1(ihe)..   z_hot_out(ihe) =g= T_hot_out(ihe) - T_hot_out_max
      (ihe)*(1-y_he(ihe)) ;
 671  eq_penalty_lim2(ihe)..   z_hot_out(ihe) =l= T_hot_out(ihe) - T_hot_out_min
      (ihe)*(1-y_he(ihe)) ;
 672  eq_penalty_lim3(ihe)..   z_hot_out(ihe) =g= T_hot_out_min(ihe)*y_he(ihe) ;
 673  eq_penalty_lim4(ihe)..   z_hot_out(ihe) =l= T_hot_out_max(ihe)*y_he(ihe) ;
 674  eq_penalty_lim5(ihe)..   (T_hot_out(ihe)-T_hot_out_spe(ihe)) =g= (1-y_he(i
      he))*(T_hot_out_min(ihe)-T_hot_out_spe(ihe));
 675  eq_penalty_lim6(ihe)..   (T_hot_out(ihe)-T_hot_out_spe(ihe)) =l= (y_he(ihe
      ))*(T_hot_out_max(ihe)-T_hot_out_spe(ihe));
 676   
 677  * Custos
 678  eq_cope..               cope   =e= sum(ipump,sum(s,y_pu(ipump,s)*f_pu(ipum
      p,s))*k_edge(ipump)*g/eta*(nop*pc/1000)) ;
 679  eq_cpipe..              cpipe =e= sum((ipipe,n),cpi(n)*y_pi(ipipe,n)*(1-yp
      i_existent(ipipe,n))*l(ipipe));
 680  eq_cpump..              cpump =e= sum((ipump,s),cpu(s)*y_pu(ipump,s)*(1-yp
      u_existent(ipump,s)));
 681  eq_cpen..               cpen  =e= sum(ihe,che(ihe));
 682   
 683  * FOB
 684  eq_fob..                fob =e= cpipe + cpump + cope;
 685  eq_fob_w_penalty..      fob =e= cpipe + cpump + cope + cpen;
 686  eq_forced..             cpen =l= cpen_limit;
 687  eq_fob_quad_dif_k..       fob =e= 1000*sum(ihe,(k_edge(ihe)-k_edge_spe(ihe
      ))*(k_edge(ihe)-k_edge_spe(ihe)));
 688   
 689  * Budget
 690  eq_budget..   cpipe + cpump =l= Budget ;
 691  eq_no_budget.. cpipe + cpump =e= 0;
