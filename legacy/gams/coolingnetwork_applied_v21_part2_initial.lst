 637  eq_T_hot_out_spe(ihe).. T_hot_out(ihe) =e= T_hot_out_spe(ihe);
 638   
 639  * Trocadores
 640  eq_cr(ihe)..         cr(ihe)*(k_edge(ihe)*cp_w) =e= (k_he_hot(ihe)*cp_hot(ihe));
 641  eq_h_w(ihe)..        h_w(ihe)   =e= h_w_d(ihe)*(k_edge(ihe)/k_he_w_d(ihe))**0.8;
 642  eq_h_hot(ihe)..      h_hot(ihe) =e= h_hot_d(ihe)*(k_he_hot(ihe)/k_he_hot_d(ihe))**0.6;
 643  eq_U(ihe)..          U(ihe)*(h_hot(ihe)*(D_he_ext(ihe)/D_he_int(ihe)) + (h_w(ihe)*h_hot(ihe)/(2*k_wall))*D_he_ext(ihe)*log(D_he_ext(ihe)/D_he_int(ihe)) + h_w(ihe) + h_w(ihe)*h_hot(ihe)*Rf_tot(ihe) ) =e=  h_w(ihe)*h_hot(ihe) ;
 644  eq_NTU(ihe)..        NTU(ihe)*(k_he_hot(ihe)*cp_hot(ihe)) =e= U(ihe)*A_he(ihe);
 645  eq_epsilon(ihe)..    epsilon(ihe)*((1 + CR(ihe))*(1 - exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) ))) + sqrt(1+sqr(CR(ihe))) * ( (1 + exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) ))) )) =e= 2*(1 - exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) )));
 646  eq_T_hot_out(ihe)..  T_hot_in(ihe)-T_hot_out(ihe) =e= epsilon(ihe)*(T_hot_in(ihe)-T_w_in(ihe));
 647  eq_T_w_out(ihe)..    T_w_out(ihe) =e= T_w_in(ihe) + cr(ihe)*epsilon(ihe)*(T_hot_in(ihe)-T_w_in(ihe));
 648   
 649  * Torre Simplificada
 650  eq_T_w_in(ihe)..    (T_w_in(ihe)-T_w_wb)*epsilon_tower =e= (T_w_feed-T_w_in(ihe)) ;
 651   
 652  * Torre Detalhada
 653  eq_Hsat_m(m_Merkel)..    Hsat_m(m_Merkel) =e= (a_Hsat + b_Hsat*T_w_m(m_Merkel) + c_Hsat * exp(d_Hsat*T_w_m(m_Merkel)))*1e3;
 654  eq_T_w_m(m_Merkel)..     T_w_m(m_Merkel)   =e= T_w_base + (T_w_feed -T_w_base)*alfa_torre(m_Merkel);
 655  eq_H_m(m_Merkel)..       H_m(m_Merkel)    =e= Hatm + cp_w*rho*sum(ihe,q_edge(ihe))*(T_w_m(m_Merkel)-T_w_base)/m_air;
 656  eq_IM..                  IM =e= (cp_w*(T_w_feed - T_w_base)/4)*sum(m_Merkel,1/(Hsat_m(m_Merkel)-H_m(m_Merkel)+1));
 657  eq_Ip..                  Ip*(rho*sum(ihe,q_edge(ihe))/m_air)**n_torre =e= delta_pack*C_un;
 658  eq_Merkel..              IM =e= Ip;
 659  eq_torre_lim..           T_w_base =l= T_w_feed;
 660  eq_T_w_in_torre(ihe)..   T_w_in(ihe) =e= T_w_base ;
 661  eq_T_w_base_lim..        T_w_base =g= T_w_wb;
 662   
 663  * Torre
 664  eq_T_w_feed_limit.. T_w_feed =l= T_w_feed_max;
 665  eq_T_w_feed..       T_w_feed*sum(ihe,k_edge(ihe)) =e= sum(ihe,k_edge(ihe)*T_w_out(ihe));
 666   
 667  * Penalidade
 668  eq_che(ihe)..            che(ihe) =e= pen(ihe)*(z_hot_out(ihe) - T_hot_out_spe(ihe)*y_he(ihe));
 669  eq_penalty_lim1(ihe)..   z_hot_out(ihe) =g= T_hot_out(ihe) - T_hot_out_max(ihe)*(1-y_he(ihe)) ;
 670  eq_penalty_lim2(ihe)..   z_hot_out(ihe) =l= T_hot_out(ihe) - T_hot_out_min(ihe)*(1-y_he(ihe)) ;
 671  eq_penalty_lim3(ihe)..   z_hot_out(ihe) =g= T_hot_out_min(ihe)*y_he(ihe) ;
 672  eq_penalty_lim4(ihe)..   z_hot_out(ihe) =l= T_hot_out_max(ihe)*y_he(ihe) ;
 673  eq_penalty_lim5(ihe)..   (T_hot_out(ihe)-T_hot_out_spe(ihe)) =g= (1-y_he(ihe))*(T_hot_out_min(ihe)-T_hot_out_spe(ihe));
 674  eq_penalty_lim6(ihe)..   (T_hot_out(ihe)-T_hot_out_spe(ihe)) =l= (y_he(ihe))*(T_hot_out_max(ihe)-T_hot_out_spe(ihe));
 675   
