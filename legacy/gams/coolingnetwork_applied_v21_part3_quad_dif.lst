 384  * Costs ========================================================================
 385   
 386  Parameter cpi(n) pipe section nominal eq_fob ;
 387            cpi(n) = ((c1/0.3048)*(dnom(n)/12)**m) ;
 388   
 389  Parameter fpud(s) pump head design ;
 390            fpud(s)= sum(i,a(i,s)*(qpud(s))**i.val) ;
 391   
 392  Parameter ft(s) pump capital eq_fob factor ft;
 393        ft(s) = exp(sum(j,b(j)*(log(28710*qpud(s)*fpud(s)**0.5))**j.val)) ;
 394   
 395  Parameter zpu(s) pump capital eq_fob factor zpu;
 396        zpu(s) = 28710*qpud(s)*fpud(s)**0.5 ;
 397   
 398  Parameter cpu(s) pump eq_fob ;
 399        cpu(s) = rfactor*fi*fms*fm*ft(s)*(1.39*exp(8.833-0.6019*log(zpu(s))+0.0519*(log(zpu(s)))**2))  ;
 400   
