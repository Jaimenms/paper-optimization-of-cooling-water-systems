 599   
 600  * Auxiliares
 601  *eq_lvalve_open(ipipe).. 0 =e= lvalve(icirc);
 602  eq_dummy..              dummy =e= 0;
 603   
 604  * Unidade de escolhas
 605  eq_ypi_unity(ipipe)..   1 =e= sum(n,y_pi(ipipe,n));
 606  eq_ypu_unity(ipump)..   1 =e= sum(s,y_pu(ipump,s));
 607   
 608  * Vazoes
 609  eq_k_edge(iedge)..      k_edge(iedge) =e= rho*q_edge(iedge);
 610  eq_q_edge(iedge)..      q_edge(iedge) =e= sum(icirc,LAMBDA(icirc,iedge)*q_circ(icirc));
 611   
 612  * Mass Balance
 613  eq_mass(inode)..        sum(iedge,K(inode,iedge)*k_edge(iedge)) + w_node(inode) =e= 0;
 614  eq_mass_espec(inode_espec).. w_node(inode_espec) =e= 0;
 615   
 616  * Heads
 617  eq_f_he(ihe)..          f_he(ihe)       =e= f_he_w_d(ihe)*(k_edge(ihe)/k_he_w_d(ihe))**alfa;
 618  eq_f_pi(ipipe,n)..      f_pi(ipipe,n)   =e= (10.67/(c_hw**1.85))*(q_edge(ipipe)**1.852)/(din(n)**4.8704)*l(ipipe);
 619  eq_f_pu(ipump,s)..      f_pu(ipump,s)       =e= sum(i,a(i,s)*(q_edge(ipump))**i.val) ;
 620   
 621  * Hidraulica
 622  eq_circ(icirc)..        0.0 =e= sum(ipump,sum(s,y_pu(ipump,s)*LAMBDA(icirc,ipump)*f_pu(ipump,s))) - dz - sum((ipipe,n),LAMBDA(icirc,ipipe)*f_pi(ipipe,n)*y_pi(ipipe,n)) - sum(ihe,LAMBDA(icirc,ihe)*f_he(ihe)) - lvalve(icirc);
 623   
 624  * Velecidade Máxima
 625  eq_vteste(ipipe)..      vteste(ipipe) - sum(n,4*zq_k_n(ipipe,n)/pi/(din(n)**2)) =e= 0;
 626  eq_vmax(ipipe)..        vmax =g= vteste(ipipe);
 627  eq_vmin(ipipe)..        vmin =l= vteste(ipipe);
 628  eq_vmax_lim1(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge(ipipe) - q_edge_max(ipipe)*(1-y_pi(ipipe,n));
 629  eq_vmax_lim2(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge(ipipe) - q_edge_min(ipipe)*(1-y_pi(ipipe,n)) ;
 630  eq_vmax_lim3(ipipe,n).. zq_k_n(ipipe,n) =g= q_edge_min(ipipe)*y_pi(ipipe,n);
 631  eq_vmax_lim4(ipipe,n).. zq_k_n(ipipe,n) =l= q_edge_max(ipipe)*y_pi(ipipe,n) ;
 632   
 633   
 634   
 635  * Especificacoes
 636  eq_k_hot(ihe)..         k_he_hot(ihe) =e= fator_k_he_hot_spe(ihe)*k_he_hot_d(ihe);
