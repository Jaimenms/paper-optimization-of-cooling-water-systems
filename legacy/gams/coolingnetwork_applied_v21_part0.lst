 415  * Finding circ matrix (LAMBDA) from Incidence Matrix (K)
 416  Parameter LAMBDA(icirc,iedge) hydraulic circ matrix;
 417  Parameter iedge_found teste;
 418  Set jedge(iedge) edge index   / set.iedge /
 419  loop((icirc,ihe),
 420           if (ord(icirc) eq ord(ihe),
 421                   LAMBDA(icirc,ihe)=1;
 422                   iedge_found = ihe.val;
 423                   while (iedge_found NE 0,
 424                            loop(jedge,
 425                                   if (jedge.val EQ iedge_found,
 426                                     iedge_found = 0;
 427                                     loop(inode,
 428                                             if (K(inode,jedge) EQ +1,
 429                                                     loop(iedge,
 430                                                             if (K(inode,ied
      ge) EQ -1,
 431                                                                     LAMBDA(
      icirc,iedge)=1;
 432                                                                     iedge_f
      ound = iedge.val;
 433                                                             );
 434                                                     );
 435                                             );
 436                                    );
 437                                   );
 438                           );
 439                   );
 440                   iedge_found = ihe.val;
 441                   while (iedge_found NE 0,
 442                            loop(jedge,
 443                                   if (jedge.val EQ iedge_found,
 444                                     iedge_found = 0;
 445                                     loop(inode,
 446                                             if (K(inode,jedge) EQ -1,
 447                                                     loop(iedge,
 448                                                             if (K(inode,ied
      ge) EQ +1,
 449                                                                     LAMBDA(
      icirc,iedge)=1;
 450                                                                     iedge_f
      ound = iedge.val;
 451                                                             );
 452                                                     );
 453                                             );
 454                                    );
 455                                   );
 456                           );
 457                   );
 458           );
 459  );
