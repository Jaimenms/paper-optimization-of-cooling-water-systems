 637  eq_k_he_w(ihe)..        k_edge(ihe) =e= k_he_w_d(ihe);
 638  eq_T_w_in_spe(ihe)..    T_w_in(ihe) =e= T_w_in_spe;
 639  eq_T_hot_out_spe(ihe).. T_hot_out(ihe) =e= T_hot_out_spe(ihe);
 640   
 641  * Trocadores
 642  eq_cr(ihe)..         cr(ihe)*(k_edge(ihe)*cp_w) =e= (k_he_hot(ihe)*cp_hot(ihe));
 643  eq_h_w(ihe)..        h_w(ihe)   =e= h_w_d(ihe)*(k_edge(ihe)/k_he_w_d(ihe))**0.8;
 644  eq_h_hot(ihe)..      h_hot(ihe) =e= h_hot_d(ihe)*(k_he_hot(ihe)/k_he_hot_d(ihe))**0.6;
 645  eq_U(ihe)..          U(ihe)*(h_hot(ihe)*(D_he_ext(ihe)/D_he_int(ihe)) + (h_w(ihe)*h_hot(ihe)/(2*k_wall))*D_he_ext(ihe)*log(D_he_ext(ihe)/D_he_int(ihe)) + h_w(ihe) + h_w(ihe)*h_hot(ihe)*Rf_tot(ihe) ) =e=  h_w(ihe)*h_hot(ihe) ;
 646  eq_NTU(ihe)..        NTU(ihe)*(k_he_hot(ihe)*cp_hot(ihe)) =e= U(ihe)*A_he(ihe);
 647  eq_epsilon(ihe)..    epsilon(ihe)*((1 + CR(ihe))*(1 - exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) ))) + sqrt(1+sqr(CR(ihe))) * ( (1 + exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) ))) )) =e= 2*(1 - exp(-NTU(ihe)*( sqrt(1+sqr(CR(ihe))) )));
 648  eq_T_hot_out(ihe)..  T_hot_in(ihe)-T_hot_out(ihe) =e= epsilon(ihe)*(T_hot_in(ihe)-T_w_in(ihe));
 649  eq_T_w_out(ihe)..    T_w_out(ihe) =e= T_w_in(ihe) + cr(ihe)*epsilon(ihe)*(T_hot_in(ihe)-T_w_in(ihe));
 650   
 651  * Torre Simplificada
 652  eq_T_w_in(ihe)..    (T_w_in(ihe)-T_w_wb)*epsilon_tower =e= (T_w_feed-T_w_in(ihe)) ;
 653   
 654  * Torre Detalhada
 655  eq_Hsat_m(m_Merkel)..    Hsat_m(m_Merkel) =e= (a_Hsat + b_Hsat*T_w_m(m_Merkel) + c_Hsat * exp(d_Hsat*T_w_m(m_Merkel)))*1e3;
 656  eq_T_w_m(m_Merkel)..     T_w_m(m_Merkel)   =e= T_w_base + (T_w_feed -T_w_base)*alfa_torre(m_Merkel);
 657  eq_H_m(m_Merkel)..       H_m(m_Merkel)    =e= Hatm + cp_w*rho*sum(ihe,q_edge(ihe))*(T_w_m(m_Merkel)-T_w_base)/m_air;
 658  eq_IM..                  IM =e= (cp_w*(T_w_feed - T_w_base)/4)*sum(m_Merkel,1/(Hsat_m(m_Merkel)-H_m(m_Merkel)+1));
 659  eq_Ip..                  Ip*(rho*sum(ihe,q_edge(ihe))/m_air)**n_torre =e= delta_pack*C_un;
 660  eq_Merkel..              IM =e= Ip;
