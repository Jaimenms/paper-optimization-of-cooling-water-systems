 425  Parameter iedge_found teste;
 426  Set jedge(iedge) edge index   / set.iedge /
 427  loop((icirc,ihe),
 428           if (ord(icirc) eq ord(ihe),
 429                   LAMBDA(icirc,ihe)=1;
 430                   iedge_found = ihe.val;
 431                   while (iedge_found NE 0,
 432                            loop(jedge,
 433                                   if (jedge.val EQ iedge_found,
 434                                     iedge_found = 0;
 435                                     loop(inode,
 436                                             if (K(inode,jedge) EQ +1,
 437                                                     loop(iedge,
 438                                                             if (K(inode,iedge) EQ -1,
 439                                                                     LAMBDA(icirc,iedge)=1;
 440                                                                     iedge_found = iedge.val;
 441                                                             );
 442                                                     );
 443                                             );
 444                                    );
 445                                   );
 446                           );
 447                   );
 448                   iedge_found = ihe.val;
 449                   while (iedge_found NE 0,
 450                            loop(jedge,
 451                                   if (jedge.val EQ iedge_found,
 452                                     iedge_found = 0;
 453                                     loop(inode,
 454                                             if (K(inode,jedge) EQ -1,
 455                                                     loop(iedge,
 456                                                             if (K(inode,iedge) EQ +1,
 457                                                                     LAMBDA(icirc,iedge)=1;
 458                                                                     iedge_found = iedge.val;
 459                                                             );
