 420   
 421  * Finding circ matrix (LAMBDA) from Incidence Matrix (K)
 422  Parameter LAMBDA(icirc,iedge) hydraulic circ matrix;
 423  Parameter iedge_found teste;
 424  Set jedge(iedge) edge index   / set.iedge /
 425  loop((icirc,ihe),
 426           if (ord(icirc) eq ord(ihe),
 427                   LAMBDA(icirc,ihe)=1;
 428                   iedge_found = ihe.val;
 429                   while (iedge_found NE 0,
 430                            loop(jedge,
 431                                   if (jedge.val EQ iedge_found,
 432                                     iedge_found = 0;
 433                                     loop(inode,
 434                                             if (K(inode,jedge) EQ +1,
 435                                                     loop(iedge,
 436                                                             if (K(inode,ied
      ge) EQ -1,
 437                                                                     LAMBDA(
      icirc,iedge)=1;
 438                                                                     iedge_f
      ound = iedge.val;
 439                                                             );
 440                                                     );
 441                                             );
 442                                    );
 443                                   );
 444                           );
 445                   );
 446                   iedge_found = ihe.val;
 447                   while (iedge_found NE 0,
 448                            loop(jedge,
 449                                   if (jedge.val EQ iedge_found,
 450                                     iedge_found = 0;
 451                                     loop(inode,
 452                                             if (K(inode,jedge) EQ -1,
 453                                                     loop(iedge,
 454                                                             if (K(inode,ied
      ge) EQ +1,
 455                                                                     LAMBDA(
      icirc,iedge)=1;
 456                                                                     iedge_f
      ound = iedge.val;
 457                                                             );
 458                                                     );
 459                                             );
 460                                    );
 461                                   );
 462                           );
 463                   );
 464           );
 465  );
